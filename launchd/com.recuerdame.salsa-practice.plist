<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.recuerdame.salsa-practice</string>
	<key>Comment</key>
	<string>Daily salsa practice reminder (random 12:00–15:00 Europe/Madrid)</string>

	<key>ProgramArguments</key>
	<array>
		<string>REPLACE_PYTHON</string>
		<string>REPLACE_PROJECT/scripts/daily_scheduler.py</string>
	</array>

	<key>WorkingDirectory</key>
	<string>REPLACE_PROJECT</string>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>12</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>TimeZone</key>
	<string>Europe/Madrid</string>

	<key>StandardOutPath</key>
	<string>REPLACE_LOGS/salsa-practice.log</string>
	<key>StandardErrorPath</key>
	<string>REPLACE_LOGS/salsa-practice.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
</dict>
</plist>
